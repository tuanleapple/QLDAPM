{
    "name": "qldapm-monorepo",
    "private": true,
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "npm --prefix backend run start:dev",
        "dev:frontend": "npm --prefix frontend run dev",
        "build": "npm --prefix backend run build && npm --prefix frontend run build",
        "test:backend": "npm --prefix backend test",
        "lint": "npm --prefix backend run lint && npm --prefix frontend run lint"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}